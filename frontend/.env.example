# Base URL of the deployed backend. It MUST include the /api/v1 prefix so that
# request paths such as /auth/register do not duplicate it.
# Local:  VITE_API_BASE_URL=http://localhost:5000/api/v1
# Deployed: VITE_API_BASE_URL=https://multi-vendor-marketplace-kt9n.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Flip to "true" to let the storefront call the live cart/orders API.
VITE_USE_API=false
